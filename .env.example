# Copy only the values you need into the PRIVATE data directory's settings.env.
# Never commit real credentials. The app starts without model weights or API keys.
# Pinokio manages PostgreSQL automatically unless DATABASE_URL is explicitly set.
# DATABASE_URL=postgresql+psycopg://compass:your-local-password@127.0.0.1:5432/compass
# COMPASS_DATA_DIR=/absolute/local/non-synced/path
COMPASS_LOCAL_ONLY=true

# Existing local Kraken installation/model files (no automatic download).
# On Windows, an independently prepared WSL worker can expose a loopback bridge.
# COMPASS_KRAKEN_WORKER_URL=http://127.0.0.1:8766
# COMPASS_KRAKEN_EXECUTABLE=/absolute/path/to/kraken
# COMPASS_KRAKEN_SEGMENTATION_MODEL=/absolute/path/to/segmentation.mlmodel
# COMPASS_KRAKEN_MEDIUM_MODEL=/absolute/path/to/medium.safetensors
# COMPASS_KRAKEN_BIBLIA_MODEL=/absolute/path/to/BiblIA_01.mlmodel
# COMPASS_KRAKEN_MELEAGRE_MODEL=/absolute/path/to/Meleagre.mlmodel
# COMPASS_KRAKEN_MUHARAF_MODEL=/absolute/path/to/muharaf_rec_best.mlmodel
# COMPASS_KRAKEN_ARAMS_MODEL=/absolute/path/to/arman.mlmodel

# Qwen llama.cpp-compatible LOCAL image server, started separately with mmproj.
# COMPASS_QWEN_BASE_URL=http://127.0.0.1:8081/v1
# Optional cloud OCR: enabling requires local-only=false AND explicit route enable.
# MISTRAL_API_KEY=
